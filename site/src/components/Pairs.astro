---
// Control and treatment clips of one task side by side. pairsview.js fills the picker, filters and grid from
// pairs.js; compare.js plays the two clips on one clock. #compare-clips keeps its ids so old links still land.
import Section from "./Section.astro";
const review = import.meta.env.BASE_URL.replace(/\/?$/, "/") + "review/";
---
<Section id="pairs" title="Control and treatment, side by side" lede="One task, two runs that differ only by the flags named below. Pick a comparison, then step through its pairs.">
  <div class="prtop">
    <label class="prsel">Comparison <select id="pr-cmp"><option>Loading pairs</option></select></label>
  </div>
  <div class="prchips" id="pr-chips" aria-label="Largest comparisons"></div>
  <div class="prfilters" id="pr-filters" hidden>
    <div class="prseg" id="pr-fam"></div>
    <div class="prseg" id="pr-seed" hidden></div>
    <label class="check"><input type="checkbox" id="pr-scores"> Show judge scores</label>
  </div>
  <p class="prdiff" id="pr-diff" hidden></p>
  <div class="sclabels" id="pr-notes" hidden></div>
  <div class="prnav" id="pr-nav" hidden>
    <button type="button" class="cvbtn" id="pr-prev" aria-label="Previous pair">Prev</button>
    <span class="prpos" id="pr-pos" aria-live="polite"></span>
    <button type="button" class="cvbtn" id="pr-next" aria-label="Next pair">Next</button>
    <a class="prreview" id="pr-review" href={review}>Review these blind</a>
  </div>
  <div class="prhand" id="pr-handbar" hidden><span>Picked by hand.</span> <button type="button" class="linkbtn" id="pr-back">Back to pairs</button></div>
  <div id="compare-clips" aria-label="Clip player">
    <div class="filters" id="cv-pick" hidden>
      <label class="wide">Test <select id="cv-test"></select></label>
      <label id="cv-trt-wrap">Treatment <select id="cv-trt"></select></label>
      <label id="cv-o1-wrap" hidden>Control <select id="cv-o1"></select></label>
      <label id="cv-o2-wrap" hidden>Treatment <select id="cv-o2"></select></label>
      <label>Task <select id="cv-task"></select></label>
    </div>
    <p class="scnote" id="cv-help" hidden></p>
    <p class="cvdiff" id="cv-diff" hidden></p>
    <p class="cvctl" id="cv-ctl" hidden></p>
    <p class="callout" id="cv-empty" style="margin-top:0">Loading published clips.</p>
    <div class="sclabels" id="cv-notes" hidden></div>
    <div class="cvbar" id="cv-bar" role="group" aria-label="Playback for all clips" hidden>
      <button type="button" class="cvbtn" id="cv-play" aria-label="Play all">Play</button>
      <button type="button" class="cvbtn" id="cv-back" aria-label="Back one frame" title="Back one frame">&#9664;|</button>
      <button type="button" class="cvbtn" id="cv-fwd" aria-label="Forward one frame" title="Forward one frame">|&#9654;</button>
      <input type="range" id="cv-seek" min="0" max="1" step="0.001" value="0" aria-label="Position in all clips">
      <span class="cvtime" id="cv-time" aria-live="off">0:00.0 / 0:00.0</span>
      <span class="cvspeed" role="group" aria-label="Playback speed">
        <button type="button" class="cvbtn" data-rate="0.5" aria-pressed="false">0.5x</button>
        <button type="button" class="cvbtn" data-rate="1" aria-pressed="true">1x</button>
        <button type="button" class="cvbtn" data-rate="2" aria-pressed="false">2x</button>
      </span>
      <label class="cvloop"><input type="checkbox" id="cv-loop" checked> Loop</label>
      <label class="cvloop" id="cv-auto-wrap"><input type="checkbox" id="cv-auto"> Auto next</label>
      <button type="button" class="cvbtn" id="cv-swap" aria-pressed="false" title="Swap sides (S)">Swap sides</button>
      <button type="button" class="cvbtn" id="cv-full">Full screen</button>
      <button type="button" class="cvbtn" id="cv-link">Copy link</button>
      <span class="copied" id="cv-copied" role="status" aria-live="polite"></span>
    </div>
    <div class="cvgrid" id="cv-grid" aria-live="polite"></div>
    <p class="scnote" id="cv-note" hidden>A shorter clip holds its last frame.</p>
  </div>
  <div class="prsticky" id="pr-sticky" hidden>
    <button type="button" class="cvbtn" id="prs-prev" aria-label="Previous pair">Prev</button>
    <button type="button" class="cvbtn primary" id="prs-play" aria-label="Play both clips">Play</button>
    <button type="button" class="cvbtn" id="prs-next" aria-label="Next pair">Next</button>
    <span class="prcount" id="prs-count"></span>
  </div>
  <h3 class="prh" id="pr-gridh" hidden>All pairs in this comparison</h3>
  <div class="prgrid" id="pair-grid" aria-label="Pairs"></div>
  <p class="scnote" id="watch-note">English judge comments were machine-translated after scoring; "show original" has the judge's own text. Task images come from <a href="https://github.com/kxding/PlayWorld" target="_blank" rel="noopener">PlayWorld</a> (Pexels and web image search, their terms). Videos: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>, non-commercial. <a href="https://github.com/benceruleanlu/playworld-advancement/issues/new?title=Scene+removal+request" target="_blank" rel="noopener">Request removal</a>. To judge two clips by eye without knowing which is which, use the <a href={review}>blind review page</a>.</p>
  <p class="prhandlink"><button type="button" class="linkbtn" id="pr-hand">Pick any two runs by hand</button></p>
</Section>

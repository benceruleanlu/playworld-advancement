---
// The published full-benchmark scores and any 171-task result of ours, rendered by app.js (renderRuler, renderFullResult).
---
<section class="scoresec" id="scores-sec" aria-labelledby="scores-h2">
  <div class="baseline" id="fullres" hidden></div>
  <div class="baseline" id="scores">
    <h2 id="scores-h2">Published full-benchmark scores, from the PlayWorld paper</h2>
    <div id="ruler" class="ruler"><div class="sk" style="height:96px"></div></div>
    <p class="note" id="full"></p>
  </div>
</section>

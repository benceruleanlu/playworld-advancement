<div class="tour" id="tour" role="region" aria-label="Guided tour" hidden>
  <div class="tour-track" aria-hidden="true"><div id="tour-prog"></div></div>
  <div class="wrap">
    <button type="button" class="cvbtn" id="tour-prev" aria-label="Previous step">&#8592;</button>
    <div class="tour-text" aria-live="polite">
      <div class="tour-head"><span class="tour-n" id="tour-n"></span><b id="tour-title"></b></div>
      <p id="tour-line"></p>
    </div>
    <button type="button" class="cvbtn" id="tour-auto" aria-pressed="false" title="Advance by itself (A)">Auto</button>
    <button type="button" class="cvbtn primary" id="tour-next">Next &#8594;</button>
    <button type="button" class="cvbtn" id="tour-exit" aria-label="Exit tour">Exit</button>
  </div>
</div>

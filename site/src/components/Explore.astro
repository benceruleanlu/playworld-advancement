---
// Reference material behind the story, as three tabs of one section. The panel ids are the old section ids, so deep links still land.
import Section from "./Section.astro";
---
<Section id="watch" title="Explore" lede="Browse one run's clips, or read every test and every run.">
  <div class="tabs" role="tablist" aria-label="Explore">
    <button type="button" role="tab" id="tab-scenes" aria-controls="scenes" aria-selected="true">Browse a run</button>
    <button type="button" role="tab" id="tab-tests" aria-controls="testing" aria-selected="false">All tests</button>
    <button type="button" role="tab" id="tab-runs" aria-controls="runs" aria-selected="false">All runs</button>
  </div>
  <div id="scenes" role="tabpanel" aria-labelledby="tab-scenes">
    <div class="filters" id="scenes-filters" hidden>
      <label>Run <select id="sc-run"></select></label>
      <label>Family <select id="sc-fam"></select></label>
    </div>
    <p class="scdesc" id="sc-desc" hidden></p>
    <div class="sclabels" id="sc-labels" hidden></div>
    <p class="callout" id="sc-empty" style="margin-top:0">Loading scenes.</p>
    <div class="scenes" id="sc-grid" aria-live="polite"></div>
    <p class="scnote" id="sc-attr"><span id="sc-model"></span><a id="sc-files" href="https://github.com/benceruleanlu/playworld-advancement/releases" target="_blank" rel="noopener" hidden>All files of this run</a> English judge comments were machine-translated after scoring; "show original" has the judge's own text. Task images come from <a href="https://github.com/kxding/PlayWorld" target="_blank" rel="noopener">PlayWorld</a> (Pexels and web image search, their terms). Videos: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>, non-commercial. <a href="https://github.com/benceruleanlu/playworld-advancement/issues/new?title=Scene+removal+request" target="_blank" rel="noopener">Request removal</a>.</p>
  </div>
  <div id="testing" role="tabpanel" aria-labelledby="tab-tests" hidden>
    <p class="sub">Off by default. Kept only if tasks move a full point on two seeds.</p>
    <div id="methods"><div class="sk" style="height:140px"></div></div>
  </div>
  <div id="runs" role="tabpanel" aria-labelledby="tab-runs" hidden>
    <div class="filters" id="filters">
      <label class="check"><input type="checkbox" id="f-capped"> Capped smoke runs <span id="capped-count" class="std"></span></label>
      <label class="check"><input type="checkbox" id="f-ended"> Runs without a score <span id="ended-count" class="std"></span></label>
      <label class="check"><input type="checkbox" id="f-tests"> Pipeline tests <span id="tests-count" class="std"></span></label>
    </div>
    <div class="scroll"><table id="board"><tbody><tr class="skrow"><td><div class="sk"></div></td></tr><tr class="skrow"><td><div class="sk"></div></td></tr><tr class="skrow"><td><div class="sk"></div></td></tr></tbody></table></div>
    <button type="button" class="scmore" id="runs-more" hidden></button>
    </div>
</Section>

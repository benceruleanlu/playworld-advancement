<section id="runs" aria-labelledby="h-runs">
  <h2 id="h-runs" class="sec">Runs</h2>
  <p class="sub">Click a heading to sort.</p>
  <div class="filters" id="filters">
    <label class="check"><input type="checkbox" id="f-capped"> Capped smoke runs <span id="capped-count" class="std"></span></label>
    <label class="check"><input type="checkbox" id="f-ended"> Runs without a score <span id="ended-count" class="std"></span></label>
    <label class="check"><input type="checkbox" id="f-tests"> Pipeline tests <span id="tests-count" class="std"></span></label>
  </div>
  <div class="scroll"><table id="board"><tbody><tr class="skrow"><td><div class="sk"></div></td></tr><tr class="skrow"><td><div class="sk"></div></td></tr><tr class="skrow"><td><div class="sk"></div></td></tr></tbody></table></div>
  <button type="button" class="scmore" id="runs-more" hidden></button>
</section>

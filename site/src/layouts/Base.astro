---
import "../styles/global.css";
// title and description default to the main page; other pages pass their own
const { title = "PlayWorld Advancement", description = "Live experiment results for the PlayWorld advancement hackathon project: inference-time changes to LingBot-World v2, scored on dev subsets of the benchmark." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta property="og:title" content="PlayWorld Advancement">
    <meta property="og:type" content="website">
    <!-- Static text, not data-driven: update this, the meta description, README.md line 5 and research/demo-video.md once a 171-task run is scored. -->
    <meta property="og:description" content="Inference-time changes to an open world model, LingBot-World v2, with no training, scored on PlayWorld dev tasks by the benchmark's judge. No full 171-task run.">
    <meta property="og:url" content="https://benceruleanlu.github.io/playworld-advancement/">
    <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)">
    <meta name="description" content={description}>
    <link rel="icon" href="data:,">
  </head>
  <body>
    <slot />
  </body>
</html>

---
// Static shell. All numbers are rendered client-side by src/scripts/app.js from the live CSV.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Header from "../components/Header.astro";
import Story from "../components/Story.astro";
import Loop from "../components/Loop.astro";
import Tour from "../components/Tour.astro";
import Watch from "../components/Watch.astro";
import Scores from "../components/Scores.astro";
import Testing from "../components/Testing.astro";
import Runs from "../components/Runs.astro";
---
<Base>
  <a class="skip" href="#top">Skip to results</a>
  <Nav />
  <main class="wrap" id="top" aria-busy="true" tabindex="-1">
    <div class="view lead">
      <Header />
    </div>
    <Scores />
    <Story />
    <Watch />
    <Loop />
    <Testing />
    <Runs />
  </main>
  <footer class="wrap" id="foot"></footer>
  <Tour />
  <script>
    import "../scripts/app.js";
    import "../scripts/compare.js";
  </script>
</Base>
